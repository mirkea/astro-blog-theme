---
import Base from "../layouts/Base.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
---

<Base title="Page not found" noindex>
  <Section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <h1 class="display !text-[clamp(7rem,22vw,14rem)]">404</h1>
    <p class="title-sm tone-2 mt-2">This page isn't here.</p>
    <p class="lead mx-auto mt-6 max-w-md">It may have moved, or the link has a typo.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button href="/" size="lg">Back home</Button>
      <Button href="/blog" variant="secondary" size="lg">Read the blog</Button>
    </div>
  </Section>
</Base>
