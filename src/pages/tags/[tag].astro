---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Section from "../../components/ui/Section.astro";
import Icon from "../../components/ui/Icon.astro";
import { getPosts, getTags, minutesToRead, postHref } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map(({ name }) => ({
    params: { tag: name },
    props: { posts: posts.filter((p) => p.data.tags.includes(name)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const related = getTags(posts).filter((t) => t.name !== tag).slice(0, 6);
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <Section tight>
    <a href="/tags" class="link-more text-ink-2 hover:text-ink"><Icon name="chevron-right" class="rotate-180" /> All topics</a>
    <h1 class="display mt-8">#{tag}</h1>
    <p class="lead mt-6">{posts.length} {posts.length === 1 ? "post" : "posts"} tagged <span class="text-ink">{tag}</span>.</p>
    {
      related.length > 0 && (
        <div class="mt-10">
          <h2 class="caption mb-3">Related topics</h2>
          <div class="flex flex-wrap gap-2">
            {related.map((t) => <a href={`/tags/${t.name}`} class="pill">#{t.name}</a>)}
          </div>
        </div>
      )
    }
  </Section>
  <Section tone="surface">
    <div class="rise grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} href={postHref(post)} readingTime={minutesToRead(post)} tags={post.data.tags} image={post.data.image} tone="white" />
        ))
      }
    </div>
  </Section>
</Base>
